{
  "name": "model-mammo",
  "version": "1.0.0",
  "description": "Breast Cancer Screening Clinical Decision Model",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:library": "node src/generate-library.js",
    "test:generate": "node src/test-generator.js",
    "test:deploy": "node src/test-deployer.js",
    "test:evaluate": "node src/test-runner.js",
    "test:evaluate-client": "node src/test-runner-client.js",
    "test:teardown": "node src/test-teardown.js",
    "test:cycle": "npm run test:generate -- --all && npm run test:deploy -- --all && npm run test:evaluate -- --all && npm run test:teardown -- --all",
    "emr": "cd mock-emr && npm run dev"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "cql-exec-fhir": "^2.1.5",
    "cql-execution": "^3.3.0",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.3.4"
  }
}
