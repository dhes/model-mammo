<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:feel="http://www.omg.org/spec/DMN/20191111/FEEL/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_USPSTF_TobaccoCessation_MaxComputable" name="USPSTF Tobacco Cessation - Max Computable" namespace="http://example.org/dmn/uspstf/tobacco-cessation/max-computable" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <inputData id="Input_ageYears" name="ageYears">
    <variable id="Var_ageYears" name="ageYears" typeRef="number" />
  </inputData>
  <inputData id="Input_tobaccoUseStatus" name="tobaccoUseStatus">
    <variable id="Var_tobaccoUseStatus" name="tobaccoUseStatus" typeRef="string" />
  </inputData>
  <inputData id="Input_pregnancyStatus" name="pregnancyStatus">
    <variable id="Var_pregnancyStatus" name="pregnancyStatus" typeRef="string" />
  </inputData>
  <decision id="Decision_AdultApplicability" name="Adult Applicability">
    <variable id="Var_adultApplies" name="adultApplies" typeRef="boolean" />
    <informationRequirement id="IR_AgeYears">
      <requiredInput href="#Input_ageYears" />
    </informationRequirement>
    <decisionTable id="DT_AdultApplicability" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="DT1_In1" label="ageYears">
        <inputExpression id="DT1_InExpr1" typeRef="number">
          <text>ageYears</text>
        </inputExpression>
      </input>
      <output id="DT1_Out1" name="adultApplies" typeRef="boolean" />
      <rule id="DT1_Rule1">
        <inputEntry id="DT1_R1_In1">
          <text>&gt;= 18</text>
        </inputEntry>
        <outputEntry id="DT1_R1_Out1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DT1_Rule2">
        <inputEntry id="DT1_R2_In1">
          <text>&lt; 18</text>
        </inputEntry>
        <outputEntry id="DT1_R2_Out1">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_TobaccoUseAssessmentTask" name="Tobacco Use Assessment Task">
    <variable id="Var_taskAskTobaccoUse" name="taskAskTobaccoUse" typeRef="Any" />
    <informationRequirement id="IR_AdultApplies_ForAsk">
      <requiredDecision href="#Decision_AdultApplicability" />
    </informationRequirement>
    <informationRequirement id="IR_TobaccoUseStatus_ForAsk">
      <requiredInput href="#Input_tobaccoUseStatus" />
    </informationRequirement>
    <decisionTable id="DT_TobaccoUseAssessmentTask" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="DT2_In1" label="adultApplies">
        <inputExpression id="DT2_InExpr1" typeRef="boolean">
          <text>adultApplies</text>
        </inputExpression>
      </input>
      <input id="DT2_In2" label="tobaccoUseStatus" biodi:width="241">
        <inputExpression id="DT2_InExpr2" typeRef="string">
          <text>tobaccoUseStatus</text>
        </inputExpression>
      </input>
      <output id="DT2_Out1" name="taskAskTobaccoUse" typeRef="Any" />
      <rule id="DT2_Rule1">
        <inputEntry id="DT2_R1_In1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="DT2_R1_In2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="DT2_R1_Out1">
          <text>{ code: "ASK_TOBACCO", status: "not_applicable", reason: "USPSTF directive applies to adults (age ≥ 18)" }</text>
        </outputEntry>
      </rule>
      <rule id="DT2_Rule2">
        <inputEntry id="DT2_R2_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT2_R2_In2">
          <text>"unknown"</text>
        </inputEntry>
        <outputEntry id="DT2_R2_Out1">
          <text>{ code: "ASK_TOBACCO", status: "due", reason: "Tobacco use status missing/unknown; ask patient about tobacco use" }</text>
        </outputEntry>
      </rule>
      <rule id="DT2_Rule3">
        <inputEntry id="DT2_R3_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT2_R3_In2">
          <text>"current","former","never"</text>
        </inputEntry>
        <outputEntry id="DT2_R3_Out1">
          <text>{ code: "ASK_TOBACCO", status: "not_due", reason: "Tobacco use already documented" }</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_CessationInterventionTasks" name="Cessation Intervention Tasks">
    <variable id="Var_cessationTasks" name="cessationTasks" typeRef="Any" />
    <informationRequirement id="IR_AdultApplies_ForCessation">
      <requiredDecision href="#Decision_AdultApplicability" />
    </informationRequirement>
    <informationRequirement id="IR_TobaccoUseStatus_ForCessation">
      <requiredInput href="#Input_tobaccoUseStatus" />
    </informationRequirement>
    <informationRequirement id="IR_PregnancyStatus_ForCessation">
      <requiredInput href="#Input_pregnancyStatus" />
    </informationRequirement>
    <decisionTable id="DT_CessationInterventionTasks" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="DT3_In1" label="adultApplies">
        <inputExpression id="DT3_InExpr1" typeRef="boolean">
          <text>adultApplies</text>
        </inputExpression>
      </input>
      <input id="DT3_In2" label="tobaccoUseStatus">
        <inputExpression id="DT3_InExpr2" typeRef="string">
          <text>tobaccoUseStatus</text>
        </inputExpression>
      </input>
      <input id="DT3_In3" label="pregnancyStatus">
        <inputExpression id="DT3_InExpr3" typeRef="string">
          <text>pregnancyStatus</text>
        </inputExpression>
      </input>
      <output id="DT3_Out1" name="cessationTasks" typeRef="Any" />
      <rule id="DT3_Rule1">
        <inputEntry id="DT3_R1_In1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="DT3_R1_In2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="DT3_R1_In3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="DT3_R1_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "not_applicable", reason: "Not in adult scope" },
          { code: "OFFER_BEHAVIORAL", status: "not_applicable", reason: "Not in adult scope" },
          { code: "OFFER_FDA_PHARMACO", status: "not_applicable", reason: "Not in adult scope" }
        ]</text>
        </outputEntry>
      </rule>
      <rule id="DT3_Rule2">
        <inputEntry id="DT3_R2_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT3_R2_In2">
          <text>"unknown"</text>
        </inputEntry>
        <inputEntry id="DT3_R2_In3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="DT3_R2_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "not_due", reason: "Tobacco use unknown; complete ASK_TOBACCO first" },
          { code: "OFFER_BEHAVIORAL", status: "not_due", reason: "Tobacco use unknown; complete ASK_TOBACCO first" },
          { code: "OFFER_FDA_PHARMACO", status: "not_due", reason: "Tobacco use unknown; complete ASK_TOBACCO first" }
        ]</text>
        </outputEntry>
      </rule>
      <rule id="DT3_Rule3">
        <inputEntry id="DT3_R3_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT3_R3_In2">
          <text>"current"</text>
        </inputEntry>
        <inputEntry id="DT3_R3_In3">
          <text>"notPregnant"</text>
        </inputEntry>
        <outputEntry id="DT3_R3_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "due", reason: "Advise to stop using tobacco" },
          { code: "OFFER_BEHAVIORAL", status: "due", reason: "Provide behavioral interventions for cessation" },
          { code: "OFFER_FDA_PHARMACO", status: "due", reason: "Offer FDA-approved pharmacotherapy for cessation (nonpregnant adult)" }
        ]</text>
        </outputEntry>
      </rule>
      <rule id="DT3_Rule4">
        <inputEntry id="DT3_R4_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT3_R4_In2">
          <text>"current"</text>
        </inputEntry>
        <inputEntry id="DT3_R4_In3">
          <text>"pregnant"</text>
        </inputEntry>
        <outputEntry id="DT3_R4_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "due", reason: "Advise to stop using tobacco" },
          { code: "OFFER_BEHAVIORAL", status: "due", reason: "Provide behavioral interventions for cessation" },
          { code: "OFFER_FDA_PHARMACO", status: "not_due", reason: "USPSTF directive scopes pharmacotherapy recommendation to nonpregnant adults; handle pregnancy-specific guidance separately" }
        ]</text>
        </outputEntry>
      </rule>
      <rule id="DT3_Rule5">
        <inputEntry id="DT3_R5_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT3_R5_In2">
          <text>"current"</text>
        </inputEntry>
        <inputEntry id="DT3_R5_In3">
          <text>"unknown"</text>
        </inputEntry>
        <outputEntry id="DT3_R5_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "due", reason: "Advise to stop using tobacco" },
          { code: "OFFER_BEHAVIORAL", status: "due", reason: "Provide behavioral interventions for cessation" },
          { code: "OFFER_FDA_PHARMACO", status: "not_due", reason: "Pregnancy status unknown; confirm before offering pharmacotherapy" }
        ]</text>
        </outputEntry>
      </rule>
      <rule id="DT3_Rule6">
        <inputEntry id="DT3_R6_In1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="DT3_R6_In2">
          <text>"former","never"</text>
        </inputEntry>
        <inputEntry id="DT3_R6_In3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="DT3_R6_Out1">
          <text>[
          { code: "ADVISE_CESSATION", status: "not_due", reason: "Not a current tobacco user" },
          { code: "OFFER_BEHAVIORAL", status: "not_due", reason: "Not a current tobacco user" },
          { code: "OFFER_FDA_PHARMACO", status: "not_due", reason: "Not a current tobacco user" }
        ]</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_USPSTF_TobaccoCessation">
      <dmndi:DMNShape id="Shape_Input_ageYears" dmnElementRef="Input_ageYears">
        <dc:Bounds height="50" width="160" x="180" y="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Input_tobaccoUseStatus" dmnElementRef="Input_tobaccoUseStatus">
        <dc:Bounds height="50" width="160" x="160" y="305" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Input_pregnancyStatus" dmnElementRef="Input_pregnancyStatus">
        <dc:Bounds height="50" width="160" x="180" y="475" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_AdultApplicability" dmnElementRef="Decision_AdultApplicability">
        <dc:Bounds height="70" width="200" x="560" y="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_TobaccoUseAssessmentTask" dmnElementRef="Decision_TobaccoUseAssessmentTask">
        <dc:Bounds height="70" width="240" x="320" y="195" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_CessationInterventionTasks" dmnElementRef="Decision_CessationInterventionTasks">
        <dc:Bounds height="70" width="240" x="530" y="375" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ageYears_to_adult" dmnElementRef="IR_AgeYears">
        <di:waypoint x="340" y="105" />
        <di:waypoint x="540" y="115" />
        <di:waypoint x="560" y="115" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_adult_to_ask" dmnElementRef="IR_AdultApplies_ForAsk">
        <di:waypoint x="660" y="150" />
        <di:waypoint x="440" y="175" />
        <di:waypoint x="440" y="195" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_tobacco_to_ask" dmnElementRef="IR_TobaccoUseStatus_ForAsk">
        <di:waypoint x="240" y="305" />
        <di:waypoint x="440" y="285" />
        <di:waypoint x="440" y="265" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_adult_to_cessation" dmnElementRef="IR_AdultApplies_ForCessation">
        <di:waypoint x="660" y="150" />
        <di:waypoint x="690" y="355" />
        <di:waypoint x="690" y="375" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_tobacco_to_cessation" dmnElementRef="IR_TobaccoUseStatus_ForCessation">
        <di:waypoint x="240" y="355" />
        <di:waypoint x="610" y="355" />
        <di:waypoint x="610" y="375" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_pregnancy_to_cessation" dmnElementRef="IR_PregnancyStatus_ForCessation">
        <di:waypoint x="260" y="475" />
        <di:waypoint x="650" y="465" />
        <di:waypoint x="650" y="445" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
