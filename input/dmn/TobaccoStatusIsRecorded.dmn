  <decision id="Decision_1q0src9" name="Tobacco Status Is Recorded">
    <decisionTable id="DecisionTable_StatusRecorded">
      <input id="Input_1" label="Age In Years" biodi:width="150">
        <inputExpression id="InputExpression_1" typeRef="number">
          <text>AgeInYears</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ki3ceg" label="Tobacco Status Is Recorded" biodi:width="150">
        <inputExpression id="LiteralExpression_1wok7dt" typeRef="boolean">
          <text>TobaccoStatusIsRecorded</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Is Eligible" name="IsEligible" typeRef="boolean" biodi:width="150" />
      <output id="OutputClause_13402ov" label="Needs Recording" name="NeedsRecording" typeRef="boolean" biodi:width="150" />
      <rule id="DecisionRule_1khpbbx">
        <inputEntry id="UnaryTests_0jbjt5v">
          <text>&gt;=18</text>
