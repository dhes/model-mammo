<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="Definitions_12aevoh" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <decision id="Decision_0cdkyyi" name="Tobacco Interventions">
    <decisionTable id="DecisionTable_1n74cs6">
      <input id="InputClause_12npqym" label="Tobacco Use Status" biodi:width="150">
        <inputExpression id="LiteralExpression_02pknzu" typeRef="string">
          <text>TobaccoUseStatus</text>
        </inputExpression>
        <inputValues id="UnaryTests_03wxwfo">
          <text>"current","former","never"</text>
        </inputValues>
      </input>
      <input id="InputClause_1g990gr" label="Is Pregnant" biodi:width="150">
        <inputExpression id="LiteralExpression_1pnvces" typeRef="boolean">
          <text>IsPregnant</text>
        </inputExpression>
      </input>
      <output id="OutputClause_00c33kr" label="Advise To Quit" name="AdviseToQuit" typeRef="boolean" biodi:width="150" />
      <output id="OutputClause_0nd003q" label="Offer Pharmacotherapy" name="OfferPharmacotherapy" typeRef="boolean" biodi:width="150" />
      <output id="OutputClause_024c28j" label="Offer Behavioral Therapy" name="OfferBehavioralTherapy" typeRef="boolean" biodi:width="150" />
      <rule id="DecisionRule_0ghrrhf">
        <inputEntry id="UnaryTests_0v45v4c">
          <text>"current"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0hfs56g">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0muevsi">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1xl63uq">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0q5kvlv">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0md1cwu">
        <inputEntry id="UnaryTests_1jl5p0w">
          <text>"current"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1jbqdq2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_10jcni0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0bn9f9k">
          <text>false</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0gfpkvp">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1lbe3p7">
        <inputEntry id="UnaryTests_09p3hbr">
          <text>"former", "never"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0hvnju8">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_176nfiq">
          <text>false</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_04myvef">
          <text>false</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_02sxari">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_1a4jqnh" name="Status">
    <decisionTable id="DecisionTable_0xq6cau">
      <input id="InputClause_0r18gkh" label="Age In Years">
        <inputExpression id="LiteralExpression_1e2qwtt" typeRef="number">
          <text>AgeInYears</text>
        </inputExpression>
      </input>
      <input id="InputClause_02fnb4a" label="Tobacco Status Is Recorded">
        <inputExpression id="LiteralExpression_0g3bbh6" typeRef="boolean">
          <text>TobaccoStatusIsRecorded</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1yqeqiw" label="Is Eligible" name="IsEligible" typeRef="boolean" />
      <output id="OutputClause_04cj8rn" label="Needs Recording" name="NeedsRecording" typeRef="boolean" />
      <rule id="DecisionRule_00boju5">
        <inputEntry id="UnaryTests_0jhg74e">
          <text>&gt;=18</text>
        </inputEntry>
        <inputEntry id="UnaryTests_151qjfc">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_182qr3f">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_19bh0s2">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1kdxqqz">
        <inputEntry id="UnaryTests_02wjvrk">
          <text>&gt;=18</text>
        </inputEntry>
        <inputEntry id="UnaryTests_18xd2vz">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_17zdkb4">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0gfbkm3">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1fyj7v5">
        <inputEntry id="UnaryTests_1xaxxby">
          <text>&lt;18</text>
        </inputEntry>
        <inputEntry id="UnaryTests_19hpw77">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1iszo38">
          <text>false</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1sgh1qa">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
